<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="group_pos_seller" model="res.groups">
            <field name="name">POS Vendedores</field>
            <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
            <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        </record>

        <record id="group_pos_cashier" model="res.groups">
            <field name="name">POS Caja</field>
            <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
            <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        </record>

        <record id="seq_pos_pending_order" model="ir.sequence">
            <field name="name">Pedido pendiente POS</field>
            <field name="code">sg.pos.pending.order</field>
            <field name="prefix">PV-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
