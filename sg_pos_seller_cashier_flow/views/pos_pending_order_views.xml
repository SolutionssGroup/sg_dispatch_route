<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sg_pos_pending_order_tree" model="ir.ui.view">
        <field name="name">sg.pos.pending.order.tree</field>
        <field name="model">sg.pos.pending.order</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="customer_note_name"/>
                <field name="seller_id"/>
                <field name="seller_pos_config_id"/>
                <field name="amount_total"/>
                <field name="state"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <record id="view_sg_pos_pending_order_form" model="ir.ui.view">
        <field name="name">sg.pos.pending.order.form</field>
        <field name="model">sg.pos.pending.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_paid" type="object" string="Marcar facturado" invisible="state not in ('sent', 'in_cashier')" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancelar" invisible="state not in ('sent', 'in_cashier', 'returned')"/>
                    <field name="state" widget="statusbar" statusbar_visible="sent,in_cashier,returned,paid,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="customer_note_name"/>
                            <field name="partner_id"/>
                            <field name="amount_total"/>
                        </group>
                        <group>
                            <field name="seller_id"/>
                            <field name="seller_pos_config_id"/>
                            <field name="cashier_pos_config_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom_id"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="location_id"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sg_pos_pending_order" model="ir.actions.act_window">
        <field name="name">Pedidos pendientes POS</field>
        <field name="res_model">sg.pos.pending.order</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_sg_pos_pending_order"
              name="Pedidos pendientes POS"
              parent="point_of_sale.menu_point_root"
              action="action_sg_pos_pending_order"
              sequence="95"/>
</odoo>
