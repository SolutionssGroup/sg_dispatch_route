<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sg_pos_seller_cashier_flow.HideSellerPaymentButton"
       t-inherit="point_of_sale.ActionpadWidget"
       t-inherit-mode="extension">
        <xpath expr="//button[contains(@class, 'pay-order-button')]" position="attributes">
            <attribute name="t-if">pos.config.sg_pos_flow_role !== 'seller'</attribute>
        </xpath>
    </t>
</templates>
