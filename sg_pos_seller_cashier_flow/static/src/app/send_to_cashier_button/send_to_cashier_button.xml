<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="sg_pos_seller_cashier_flow.CustomerNoteNameControl">
        <div class="control-button btn btn-light rounded-0 p-0">
            <input class="form-control border-0 rounded-0 h-100"
                   type="text"
                   placeholder="Nombre cliente"
                   t-att-value="customerNoteName"
                   t-on-input="onInput"/>
        </div>
    </t>

    <t t-name="sg_pos_seller_cashier_flow.SendToCashierButton">
        <div class="control-button btn btn-light rounded-0 fw-bolder" t-on-click="onClick">
            <i class="fa fa-paper-plane" role="img" aria-label="Enviar a Caja" title="Enviar a Caja"/>
            Enviar a Caja
        </div>
    </t>
</templates>
