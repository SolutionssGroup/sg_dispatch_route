<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Conduce: solo lo que se despacho. -->
    <template id="report_delivery_document_sg_torpinsa" inherit_id="stock.report_delivery_document">
        <!-- Antes de validar, solo las lineas con cantidad recogida. -->
        <xpath expr="//t[@t-set='lines']" position="attributes">
            <attribute name="t-value">o.move_ids.filtered(lambda x: x.quantity)</attribute>
        </xpath>
        <!-- Sin el bloque "cantidades restantes": lo pendiente sale en su propio conduce (backorder). -->
        <xpath expr="//div[@t-if='not (o.backorder_ids and backorders)']" position="before">
            <t t-set="backorders" t-value="[]"/>
        </xpath>
    </template>
</odoo>
