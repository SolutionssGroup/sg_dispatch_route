<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-name="sg_dispatch_route_torpinsa.SgPickDialog">
        <Dialog title="'Recoger'" size="'md'" contentClass="'sg_pick_dialog'">
            <div class="sg_pick_head">
                <div class="sg_pick_name" t-esc="productName"/>
                <div class="sg_pick_meta text-muted">
                    <span t-if="productCode">Ref: <b t-esc="productCode"/></span>
                    <span t-if="productBarcode"> · Código: <b t-esc="productBarcode"/></span>
                </div>
            </div>

            <div t-att-class="stepClass('location')">
                <span class="sg_pick_arrow" t-if="arrowStep === 'location'"><i class="fa fa-arrow-right"/></span>
                <div class="sg_pick_step_body">
                    <div class="sg_pick_step_title">1 · Ubicación</div>
                    <t t-if="state.locationOk">
                        <div class="sg_pick_step_value"><i class="fa fa-check"/> <t t-esc="shortLocation(state.location)"/></div>
                    </t>
                    <t t-else="">
                        <div class="sg_pick_step_hint">Leer ubicación</div>
                        <div class="sg_pick_step_sub">Ve a: <b class="sg_pick_goto" t-esc="plannedLocation"/></div>
                    </t>
                </div>
            </div>

            <div t-att-class="stepClass('product')">
                <span class="sg_pick_arrow" t-if="arrowStep === 'product'"><i class="fa fa-arrow-right"/></span>
                <div class="sg_pick_step_body">
                    <div class="sg_pick_step_title">2 · Producto</div>
                    <t t-if="state.productOk">
                        <div class="sg_pick_step_value"><i class="fa fa-check"/> <t t-esc="productCode or productName"/></div>
                    </t>
                    <t t-elif="activeStep === 'product'">
                        <div class="sg_pick_step_hint">Leer producto</div>
                    </t>
                </div>
            </div>

            <div t-att-class="stepClass('qty') + (state.productOk ? ' sg_pick_tappable' : '')"
                 t-on-click="onOpenKeypad">
                <span class="sg_pick_arrow" t-if="arrowStep === 'qty'"><i class="fa fa-arrow-right"/></span>
                <div class="sg_pick_step_body">
                    <div class="sg_pick_step_title">3 · Cantidad</div>
                    <div class="sg_pick_qty_value">
                        <i t-if="qtyComplete" class="fa fa-check"/>
                        <t t-esc="displayQty"/> / <t t-esc="demand"/>
                        <span class="sg_pick_qty_uom" t-esc="uom"/>
                    </div>
                    <div t-if="state.productOk" class="sg_pick_step_sub">Toca para escribir la cantidad</div>
                </div>
            </div>

            <div t-if="state.error" class="sg_pick_error" t-esc="state.error"/>

            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="onClose">Cerrar</button>
                <button type="button" class="btn sg_pick_btn_accent" t-att-disabled="!canConfirm" t-on-click="onConfirm"><t t-esc="okLabel"/></button>
            </t>
        </Dialog>
    </t>
</templates>
