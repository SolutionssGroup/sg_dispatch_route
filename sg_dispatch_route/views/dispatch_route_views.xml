<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sg_dispatch_route_tree" model="ir.ui.view">
            <field name="name">sg.dispatch.route.tree</field>
            <field name="model">sg.dispatch.route</field>
            <field name="arch" type="xml">
                <tree string="Rutas de despacho">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="warehouse_id"/>
                    <field name="picking_type_id"/>
                    <field name="root_location_id"/>
                    <field name="strategy"/>
                    <field name="active"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <record id="view_sg_dispatch_route_form" model="ir.ui.view">
            <field name="name">sg.dispatch.route.form</field>
            <field name="model">sg.dispatch.route</field>
            <field name="arch" type="xml">
                <form string="Ruta de despacho">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Ej. Ruta despacho INPROTEC"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="active"/>
                                <field name="sequence"/>
                                <field name="warehouse_id"/>
                                <field name="picking_type_id"/>
                            </group>
                            <group>
                                <field name="root_location_id"/>
                                <field name="strategy"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Ubicaciones excluidas">
                                <field name="exclude_line_ids">
                                    <tree editable="bottom">
                                        <field name="location_id"/>
                                        <field name="note"/>
                                    </tree>
                                </field>
                            </page>

                            <page string="Resumen">
                                <group>
                                    <field name="excluded_location_ids" widget="many2many_tags" readonly="1"/>
                                    <field name="note" placeholder="Notas internas sobre esta ruta..."/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>